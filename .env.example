# ─────────────────────────────────────────────────────────────────────────────
# Air Assist — variables d'environnement (exemple exhaustif)
# Copiez ce fichier en `.env` et renseignez les valeurs. NE COMMITEZ JAMAIS `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (PostgreSQL, hébergement UE recommandé) ──────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/air_assist?schema=public"

# ── Chiffrement au repos des documents ───────────────────────────────────────
# Clé AES-256-GCM en base64 (32 octets). Générez-en une vraie en prod :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Laissez vide en dev : un adaptateur de chiffrement "mock" sera utilisé.
DOCUMENT_ENCRYPTION_KEY=""

# ── Mode des adaptateurs externes ────────────────────────────────────────────
# "mock" => tout le parcours tourne en local sans clé API.
# "live" => branche les vrais prestataires (clés ci-dessous requises).
ADAPTER_MODE="mock"

# ── Adaptateur e-mail (Phase: génération/envoi des réclamations) ─────────────
# Ex: SMTP pro, ou API transactionnelle (Postmark, Sendgrid, Brevo...).
EMAIL_PROVIDER="mock"           # mock | smtp | postmark | brevo
EMAIL_FROM="reclamations@air-assist.example"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_API_KEY=""

# ── Adaptateur signature électronique / eIDAS (mandat) ───────────────────────
# Ex: Yousign, Docusign, Universign (eIDAS qualifié recommandé en prod).
ESIGN_PROVIDER="mock"           # mock | yousign | universign | docusign
ESIGN_API_KEY=""
ESIGN_WEBHOOK_SECRET=""

# ── Adaptateur PSP / paiement & KYC (Phase 2/3 — reversement) ────────────────
# Ex: Stripe Connect, Lemonway, MangoPay (cantonnement des fonds).
# Les coordonnées bancaires vivent CHEZ LE PSP : on ne stocke qu'un token.
PSP_PROVIDER="mock"             # mock | stripe | lemonway | mangopay
PSP_API_KEY=""
PSP_WEBHOOK_SECRET=""

# ── Adaptateur données de vol (enrichissement vol/distance) ──────────────────
# Ex: AviationStack, FlightAware, OAG.
FLIGHTDATA_PROVIDER="mock"      # mock | aviationstack | flightaware
FLIGHTDATA_API_KEY=""

# ── Auth CRM (NextAuth/Auth.js) ──────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""              # openssl rand -base64 32
# Auth.js v5 lit en priorité AUTH_SECRET (mettez la même valeur qu'au-dessus).
AUTH_SECRET=""                  # openssl rand -base64 32

# ── Application ───────────────────────────────────────────────────────────────
# Commission de l'agence (fraction). 0.30 = 30 %. Le client perçoit 1 - COMMISSION.
COMMISSION_RATE="0.30"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
